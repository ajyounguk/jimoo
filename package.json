{
  "name": "jimoo",
  "version": "2.0.0",
  "description": "Jimoo: easy event feedback. Attendees rate an event with a PIN; organisers create and manage events.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajyounguk/jimoo.git"
  },
  "keywords": [
    "feedback",
    "events",
    "mongodb",
    "mongoose",
    "express"
  ],
  "author": "Andrew Young",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ajyounguk/jimoo/issues"
  },
  "homepage": "https://github.com/ajyounguk/jimoo#readme",
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "node_modules/.cache/mongodb-binaries"
    }
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
