<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Jimoo</title>
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="/assets/styles.css">
    <script src="/assets/app.js" defer></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">
            <img src="/assets/jimoo.png" alt="" width="32" height="32">
            <span class="brand-name">Jimoo</span>
            <span class="brand-tag">easy feedback</span>
        </a>
        <%- include('partials/env-badge') %>
    </header>

    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="content">
            <%- include('partials/' + view) %>
            <% if (!attendee) { %>
            <%- include('partials/response') %>
            <% } %>
        </main>
    </div>
</body>
</html>
